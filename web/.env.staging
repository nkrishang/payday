# The web app on this machine, talking to the staging API (docs/staging.md).
# `just web-staging` exports these before starting the dev server; they win
# over web/.env.local. Everything here is public and inlined into the bundle.
NEXT_PUBLIC_PAYDAY_API_URL=https://api.staging.payday.sh
# The networks staging's gatewayd offers (its PAYDAY_CHAINS), with public RPCs
# for wallet reads; never the operator endpoints staging uses.
# Single-quoted on purpose: `just web-staging` loads this file with bash
# `source`, and unquoted inner double quotes would be stripped as shell syntax.
NEXT_PUBLIC_CHAINS='[{"id":143,"name":"Monad","rpcUrl":"https://rpc.monad.xyz","usdcAddress":"0x754704Bc059F8C67012fEd69BC8A327a5aafb603","explorerUrl":"https://monadvision.com","confirmation":"Credited within seconds"},{"id":8453,"name":"Base","rpcUrl":"https://mainnet.base.org","usdcAddress":"0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913","explorerUrl":"https://basescan.org","confirmation":"Credited within a minute"},{"id":42161,"name":"Arbitrum One","rpcUrl":"https://arb1.arbitrum.io/rpc","usdcAddress":"0xaf88d065e77c8cC2239327C5EDb3A432268e5831","explorerUrl":"https://arbiscan.io","confirmation":"Credited within a minute"}]'
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# The development Privy app, which staging's gatewayd verifies sessions
# against too (PAYDAY_PRIVY_APP_ID in infra/environments/staging.tfvars).
NEXT_PUBLIC_PRIVY_APP_ID=cmt9wxn7h011h0cjsma7fzytr
# Staging's attachment bucket, so the dashboard's CSP admits the upload.
NEXT_PUBLIC_ATTACHMENT_UPLOAD_ORIGIN=https://payday-staging-invoice-attachments.s3.eu-north-1.amazonaws.com
NEXT_PUBLIC_PAYER_APPEAL_EMAIL=support@payday.sh
