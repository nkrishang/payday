# Origin of the Payday API. Production uses https://api.payday.sh; the sandbox
# deployment uses https://api.sandbox.payday.sh.
NEXT_PUBLIC_PAYDAY_API_URL=http://127.0.0.1:3000
# The networks a payer can choose to pay on, in the order the checkout lists
# them: the same chains as gatewayd's PAYDAY_CHAINS. A JSON array of
# {id, name, rpcUrl, usdcAddress, explorerUrl?, nativeSymbol?, confirmation?}.
# Every rpcUrl is a public JSON-RPC endpoint for wallet reads, never the
# operator RPC: this value ships to every browser. usdcAddress is the chain's
# exact native USDC contract; the checkout refuses to sign a transfer unless
# the deposit request's token matches it. The local stack runs two Anvils.
NEXT_PUBLIC_CHAINS=[{"id":31337,"name":"Local","rpcUrl":"http://127.0.0.1:8545","usdcAddress":"0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512","nativeSymbol":"ETH","confirmation":"Credited within seconds"},{"id":31338,"name":"Local 2","rpcUrl":"http://127.0.0.1:8546","usdcAddress":"0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512","nativeSymbol":"ETH","confirmation":"Credited within seconds"}]
# Optional WalletConnect project ID from https://cloud.reown.com. Without one
# the checkout offers injected browser wallets only.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# The Privy app the dashboard signs merchants in to (email code; an embedded
# wallet per account). Public, like every value here. There is no local
# stand-in, so this is the development app even locally; gatewayd must be
# configured with the same id as PAYDAY_PRIVY_APP_ID, and the dashboard's
# origin (http://127.0.0.1:3002 here) must be in the app's allowed domains.
NEXT_PUBLIC_PRIVY_APP_ID=cmt9wxn7h011h0cjsma7fzytr
# Origin of the presigned attachment upload URL the dashboard PUTs PDFs to, so
# the page's Content-Security-Policy can admit it: the local MinIO here, the
# attachment bucket's virtual-hosted-style URL in production
# (https://<bucket>.s3.<region>.amazonaws.com). Leave empty when uploads share
# the API origin.
NEXT_PUBLIC_ATTACHMENT_UPLOAD_ORIGIN=http://127.0.0.1:9000

# Where a payer whose identity check was declined writes to appeal; shown on
# the deposit page after a decline. Defaults to support@payday.sh.
NEXT_PUBLIC_PAYER_APPEAL_EMAIL=support@payday.sh
