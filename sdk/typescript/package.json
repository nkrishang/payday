{
  "name": "@payday/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Payday payments API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "engines": { "node": ">=18" },
  "license": "MIT",
  "publishConfig": { "access": "public" }
}
