<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sign in to Payday</title>
  </head>
  <body style="margin: 0; background: #f4f5f7; color: #15171a; font-family: Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;">
    <div style="display: none; max-height: 0; overflow: hidden; opacity: 0; color: transparent;">One code. Five minutes. Back to business.</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background: #f4f5f7; border-collapse: collapse;">
      <tr>
        <td align="center" style="padding: 40px 16px;">
          <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width: 560px; background: #ffffff; border: 1px solid #e3e5e8; border-radius: 16px; border-collapse: separate; overflow: hidden;">
            <tr>
              <td style="padding: 24px 32px; background: #111318; color: #ffffff; font-size: 17px; font-weight: 800; letter-spacing: 0.12em;">PAYDAY<span style="color: #56e39f;">.SH</span></td>
            </tr>
            <tr>
              <td style="padding: 36px 32px 32px;">
                <h1 style="margin: 0 0 12px; color: #15171a; font-size: 28px; line-height: 1.2;">Sign in to Payday</h1>
                <p style="margin: 0 0 24px; color: #555b65; font-size: 16px; line-height: 1.6;">Enter this one-time code in your terminal:</p>
                <div style="margin: 0 0 24px; padding: 18px 12px; background: #f4f5f7; border: 1px solid #d9dde3; border-radius: 10px; color: #111318; font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace; font-size: 32px; font-weight: 700; letter-spacing: 0.18em; line-height: 1.2; text-align: center;">{{ code }}</div>
                <p style="margin: 0 0 12px; color: #555b65; font-size: 15px; line-height: 1.6;">This code expires in 5 minutes.</p>
                <p style="margin: 0 0 12px; color: #555b65; font-size: 15px; line-height: 1.6;">If you didn't request this, you can safely ignore this email.</p>
                <p style="margin: 0; color: #555b65; font-size: 15px; line-height: 1.6;">Need help? Email <a href="mailto:support@payday.sh" style="color: #126b49; font-weight: 600;">support@payday.sh</a>.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
