# Three services run locally: gum-server (the API, the deposit-request state
# machine, and the only process that talks to the domain tables), gum-indexer
# (chain observer; no database, no keys — it reports to gum-server over the
# internal HTTP API), and gum-signers (the only key holder; consumes execution
# commands from the Postgres bus and publishes execution events). See
# docs/architecture.md.

# PostgreSQL connection used by gum-server and gum-signers (gum-indexer has
# none). Run `gum-server migrate` before starting either; services never
# migrate on start, and readiness refuses while the schema is behind.
DATABASE_URL=postgresql:///gateway
# Public API listener address.
PAYDAY_BIND_ADDR=127.0.0.1:3000
# End-to-end script and seed URL for the local gateway API.
PAYDAY_API_URL=http://127.0.0.1:3000
# gum-server's internal listener: the indexer RPC surface
# (/internal/v1/indexer/...) plus /health/live and /health/ready. Loopback only
# locally; on ECS it binds 0.0.0.0 and is reached through Cloud Map DNS.
PAYDAY_INTERNAL_BIND_ADDR=127.0.0.1:3010
# Where gum-indexer finds that listener.
PAYDAY_SERVER_INTERNAL_URL=http://127.0.0.1:3010
# Bearer token gum-indexer presents to the internal listener; both processes
# read the same value. Production generates a random one in Secrets Manager.
PAYDAY_INTERNAL_TOKEN=local-internal-token-0123456789abcdef
# Health listeners (/health/live, /health/ready) for the two workers.
PAYDAY_INDEXER_LISTEN_ADDR=127.0.0.1:3011
PAYDAY_SIGNERS_LISTEN_ADDR=127.0.0.1:3012
# The Privy app merchants sign in to. Its public app id is all gum-server needs:
# it names the key set dashboard sessions (Privy identity tokens) are verified
# against. There is no local stand-in — the dashboard signs in against the
# real app even locally — so this is the development app's id, and the same
# value goes in web/.env.local as NEXT_PUBLIC_PRIVY_APP_ID. Unset, gum-server
# accepts API keys only.
PAYDAY_PRIVY_APP_ID=cmt9wxn7h011h0cjsma7fzytr
# Optional: the above app's secret, from the Privy dashboard. Unrelated to
# verifying dashboard sessions — it only enables pregenerating a merchant's
# wallet the moment they submit their email at sign-up, before Privy sends
# the code, so it is often already there by the time the code comes back
# (crates/gum-server/src/pregenerated_wallet.rs). Sign-in creates a merchant's
# wallet itself regardless of whether this is set; leave it unset locally
# unless you are specifically testing this. Never commit a real value.
# PAYDAY_PRIVY_APP_SECRET=
# Explicitly permit gum-server to trust the loopback development issuer for
# payer and issuer-mailbox codes.
PAYDAY_DEV_IDENTITY=1
# Loopback socket where the development identity provider listens.
PAYDAY_DEV_IDENTITY_BIND=127.0.0.1:3001
# Exact issuer embedded in locally signed access tokens.
PAYDAY_DEV_IDENTITY_ISSUER=http://127.0.0.1:3001
# Fixes every code the development provider issues, so verifying a payer or
# an issuer mailbox locally does not mean reading it out of the runner's log.
# Leave unset for a random code.
PAYDAY_DEV_IDENTITY_OTP=123456
# Public origin used to produce local payer links. This is where the hosted
# checkout lives, not the API: point it at the web app (`just web`) so a created
# deposit links somewhere that can render it. Production uses https://payday.sh.
PAYDAY_PUBLIC_BASE_URL=http://127.0.0.1:3002
# Prefix distinguishing development credentials from live credentials.
PAYDAY_API_KEY_PREFIX=payday_test_
# Local-only bearer secret for operator recovery commands.
PAYDAY_ADMIN_BEARER_SECRET=local-admin-bearer-secret-0123456789abcdef

# The two local chains: Anvil on 8545 (chain 31337, the Monad-shaped
# `finalized` path) and Anvil on 8546 (chain 31338, the L2-shaped `latest`
# plus confirmations path). The scripts use these for their own cast calls
# and derive the per-chain variables the services read from them.
PAYDAY_CHAIN_ID=31337
PAYDAY_RPC_URL=http://127.0.0.1:8545
PAYDAY_SECOND_CHAIN_ID=31338
PAYDAY_SECOND_RPC_URL=http://127.0.0.1:8546
# Public PaymentFactory, BatchSweeper, and mock USDC / USDT addresses produced
# by Bootstrap.s.sol on a fresh Anvil (account #0's first CREATE addresses, so
# the same on both chains).
PAYDAY_FACTORY_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
PAYDAY_BATCH_SWEEPER_ADDRESS=0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
PAYDAY_USDC_ADDRESS=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
PAYDAY_USDT_ADDRESS=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
# What the services actually read: the network registry, one JSON array
# entry per chain, and one RPC URL per chain id. `just dev` and `just e2e`
# build PAYDAY_CHAINS from the running Anvils after the bootstrap
# (`build_chain_registry` in scripts/local-runner.sh), reading the two
# runtime code hashes from the chain; all three services compare them at
# startup and refuse to start on a mismatch. Each chain lists the stablecoins it
# serves under `tokens`, by currency code and the issuer's exact contract; a
# currency absent from a chain is not offered there. By hand, one entry looks like
#   {"chain_id":31337,"tokens":[{"currency":"USDC","address":"0xe7f1…"},{"currency":"USDT","address":"0xCf7E…"}],
#    "factory":"0x5FbD…","batch_sweeper":"0x9fE4…",
#    "factory_code_hash":"0x…","batch_sweeper_code_hash":"0x…","start_block":0,
#    "finality_source":"finalized","finality_confirmations":0,"block_time_ms":1000,
#    "log_range_size":100}
# with cast keccak "$(cast code "$PAYDAY_FACTORY_ADDRESS" --rpc-url "$PAYDAY_RPC_URL")"
# for each hash. Leave PAYDAY_CHAINS unset to let the runner build it.
#PAYDAY_CHAINS=[…]
PAYDAY_RPC_URL_31337=http://127.0.0.1:8545
PAYDAY_RPC_URL_31338=http://127.0.0.1:8546

# --- gum-indexer ---
# Maximum ranges drained per indexing pass matching the service default.
PAYDAY_INDEXER_MAX_RANGES_PER_TICK=20
# Fast local polling interval used by the end-to-end script.
PAYDAY_INDEXER_POLL_INTERVAL_MS=250
# How often a chain with an empty watch list re-checks gum-server for work.
PAYDAY_INDEXER_IDLE_INTERVAL_MS=2000
# How often a chain reconciles its finalized head against gum-server.
PAYDAY_INDEXER_RECONCILE_INTERVAL_MS=1000
# Anvil has no requests-per-second budget to trip, so local runs pace nothing.
PAYDAY_INDEXER_RPC_MAX_RPS=0

# --- gum-server ---
# How often the sweep scheduler groups funded deposit requests into sweep jobs
# and publishes execution commands.
PAYDAY_SWEEP_SCHEDULER_INTERVAL_MS=5000
# Circle's attestation service the withdrawal orchestrator polls for bridge
# legs; the local chains have no CCTP, so nothing polls it here.
# PAYDAY_CCTP_IRIS_URL=https://iris-api.circle.com

# --- gum-signers ---
# How often the executor polls the bus for commands and reconciles open lanes
# against the chain.
PAYDAY_SIGNERS_POLL_INTERVAL_MS=250
PAYDAY_SIGNERS_RPC_MAX_RPS=0
# Seconds before replacing an unconfirmed transaction with a fee bump.
PAYDAY_SWEEP_PENDING_TIMEOUT_SECS=60
# Maximum submissions (original plus replacements) of one transaction lane
# before the job fails as needing attention.
PAYDAY_SWEEP_MAX_SUBMISSIONS=5
# Maximum unclassified attempts before a job is failed permanently.
PAYDAY_SWEEP_MAX_ATTEMPTS=8
# Wei threshold for warning that a signer is low on native funds.
PAYDAY_SIGNER_LOW_BALANCE_WEI=50000000000000000
# The signer pool: comma-separated keys, each keeping one transaction in
# flight per chain, so several sweep jobs and withdrawal steps can run at
# once. Public Anvil account #0 plus mnemonic accounts #10 and #11 (`just dev`
# starts Anvil with twelve accounts). Production sets PAYDAY_KMS_KEY_IDS
# (comma-separated KMS key ARNs) instead; exactly one of the two may be set.
# Only gum-signers reads these.
PAYDAY_SIGNER_KEYS=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80,0xf214f2b2cd398c806f84e317254e0f0b801d0643303237d97a22a48e01628897,0x701b615bbdfb9de65240bc28bd21bbc0d996645a3dd57e7b12bc2bdf6f192c82

# Local attachment store. `just dev` and `just e2e` run MinIO in Docker with
# these credentials and create the bucket, standing in for the S3 bucket and
# for GuardDuty: nothing scans local uploads, so the verdict tag finalize
# requires is set by hand (docs/local-development.md). The runner forces these
# values to its own container, like DATABASE_URL.
PAYDAY_ATTACHMENT_BUCKET=payday-attachments-local
PAYDAY_ATTACHMENT_S3_ENDPOINT=http://127.0.0.1:9000
PAYDAY_ATTACHMENT_S3_FORCE_PATH_STYLE=1
AWS_ACCESS_KEY_ID=payday-local
AWS_SECRET_ACCESS_KEY=payday-local
AWS_REGION=us-east-1
# Signs Proof of Payment verification attestations: Anvil account #6, whose
# address 0x976EA74026E726554dB657fA54763abd0C3a0aa9 is the local trusted
# attestor. Production sets PAYDAY_ATTESTATION_KMS_KEY_ID instead; exactly one
# of the two may be set.
PAYDAY_ATTESTATION_SIGNER_KEY=0x92db14e403b83dfe3df233f83dfa3a0d7096f21ca9b0d6d6b8d88b2b4ec1564e
# Pays the dashboard onboarding walkthrough's one self-issued deposit request.
# Anvil account #1 (0x70997970C51812dc3A010C7d01b50e0d17dc79C8), already
# minted test USDC by Bootstrap.s.sol; an account outside PAYDAY_SIGNER_KEYS
# so it never contends with a sweep signer for a nonce. Optional in every
# environment, including production — unset simply disables the endpoint.
# PAYDAY_ONBOARDING_PAYER_KMS_KEY_ID is the production alternative; exactly
# one of the two may be set.
PAYDAY_ONBOARDING_PAYER_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
