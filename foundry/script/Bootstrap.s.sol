                "PaymentFactory not at expected address; run against a fresh Anvil (sender at nonce 0)"
            );
            console.log("PaymentFactory deployed at", FACTORY);
        } else {
            console.log("PaymentFactory already present at", FACTORY);
        }

        // 2. Multicall3 at its canonical address, via the anvil_setCode cheat
        //    (mutates the live node directly; no broadcast transaction).
