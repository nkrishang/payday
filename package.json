{
  "name": "gum-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "sdk/typescript",
    "web"
  ],
  "scripts": {
    "build:sdk": "npm run build --workspace @gum/sdk",
    "test:sdk": "npm test --workspace @gum/sdk",
    "dev": "npm run dev --workspace @gum/web",
    "build": "npm run build --workspace @gum/web",
    "lint": "npm run lint --workspace @gum/web",
    "test": "npm test --workspace @gum/web"
  },
  "engines": {
    "node": ">=20"
  }
}
